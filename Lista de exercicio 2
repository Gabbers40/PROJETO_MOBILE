import React, { useState } from "react";
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  ScrollView,
  StyleSheet,
} from "react-native";
import { NavigationContainer } from "@react-navigation/native";
import { createDrawerNavigator } from "@react-navigation/drawer";
import Ionicons from "react-native-vector-icons/Ionicons";

type RootStackParamList = {
  Home: undefined;
  Morning: undefined;
  Afternoon: undefined;
  Night: undefined;
  CEP: undefined;
  Consultas: undefined;
};

type Cep = {
  cep: string;
  logradouro: string;
  complemento: string;
  bairro: string;
  localidade: string;
  uf: string;
  erro?: string;
};

const Drawer = createDrawerNavigator<RootStackParamList>();

let consultas: string[] = [];

const Home = ({ navigation }: any) => {
  return (
    <View style={styles.container}>
      <Text style={styles.title}>HOME</Text>

      <View style={styles.rowButton}>
        <TouchableOpacity
          style={styles.button}
          onPress={() => navigation.navigate("Morning")}
        >
          <Text style={styles.buttonText}>Manhã</Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={styles.button}
          onPress={() => navigation.navigate("Afternoon")}
        >
          <Text style={styles.buttonText}>Tarde</Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={styles.button}
          onPress={() => navigation.navigate("Night")}
        >
          <Text style={styles.buttonText}>Noite</Text>
        </TouchableOpacity>
      </View>
    </View>
  );
};

const Manha = ({ navigation }: any) => {
  return (
    <View style={styles.container}>
      <Text style={styles.title}>Bom dia!</Text>

      <TouchableOpacity
        style={styles.button}
        onPress={() => navigation.goBack()}
      >
        <Text style={styles.buttonText}>Retornar</Text>
      </TouchableOpacity>

      <TouchableOpacity
        style={styles.button}
        onPress={() => navigation.navigate("Afternoon")}
      >
        <Text style={styles.buttonText}>Tarde</Text>
      </TouchableOpacity>
    </View>
  );
};

const Tarde = ({ navigation }: any) => {
  return (
    <View style={styles.container}>
      <Text style={styles.title}>Boa tarde!</Text>

      <TouchableOpacity
        style={styles.button}
        onPress={() => navigation.goBack()}
      >
        <Text style={styles.buttonText}>Retornar</Text>
      </TouchableOpacity>

      <TouchableOpacity
        style={styles.button}
        onPress={() => navigation.navigate("Night")}
      >
        <Text style={styles.buttonText}>Noite</Text>
      </TouchableOpacity>
    </View>
  );
};

const Noite = ({ navigation }: any) => {
  return (
    <View style={styles.container}>
      <Text style={styles.title}>Boa noite!</Text>

      <TouchableOpacity
        style={styles.button}
        onPress={() => navigation.goBack()}
      >
        <Text style={styles.buttonText}>Retornar</Text>
      </TouchableOpacity>

      <TouchableOpacity
        style={styles.button}
        onPress={() => navigation.navigate("Home")}
      >
        <Text style={styles.buttonText}>Início</Text>
      </TouchableOpacity>
    </View>
  );
};

const CEP = ({ navigation }: any) => {
  const [cep, setCep] = useState("");
  const [resultado, setResultado] = useState<Cep | null>(null);
  const [erro, setErro] = useState("");

  const buscarCep = async () => {
    setErro("");
    setResultado(null);

    const cepLimpo = cep.replace(/\D/g, "");

    if (cepLimpo.length !== 8) {
      setErro("CEP inválido");
      return;
    }

    try {
      const resposta = await fetch(
        `https://viacep.com.br/ws/${cepLimpo}/json/`
      );

      const dados: Cep = await resposta.json();

      if (dados.erro === "true") {
        setErro("CEP inválido");
        return;
      }

      consultas.push(cepLimpo);
      setResultado(dados);
    } catch {
      setErro("Erro ao consultar o CEP");
    }
  };

  return (
    <View style={styles.container}>
      <Text style={styles.title}>Consultar CEP</Text>

      <TextInput
        style={styles.input}
        placeholder="Digite o CEP"
        keyboardType="numeric"
        maxLength={9}
        value={cep}
        onChangeText={setCep}
      />

      <TouchableOpacity style={styles.button} onPress={buscarCep}>
        <Text style={styles.buttonText}>Obter</Text>
      </TouchableOpacity>

      {erro !== "" && <Text style={styles.error}>{erro}</Text>}

      {resultado && (
        <View style={styles.resultado}>
          <Text>CEP: {resultado.cep}</Text>
          <Text>Logradouro: {resultado.logradouro}</Text>
          <Text>Complemento: {resultado.complemento}</Text>
          <Text>Bairro: {resultado.bairro}</Text>
          <Text>Cidade: {resultado.localidade}</Text>
          <Text>Estado: {resultado.uf}</Text>
        </View>
      )}

      <TouchableOpacity
        style={styles.button}
        onPress={() => navigation.navigate("Consultas")}
      >
        <Text style={styles.buttonText}>Ver consultas</Text>
      </TouchableOpacity>
    </View>
  );
};

const Consultas = () => {
  return (
    <View style={styles.container}>
      <Text style={styles.title}>CEPs Consultados</Text>

      <ScrollView style={styles.lista}>
        {consultas.length === 0 ? (
          <Text style={styles.semConsultas}>
            Nenhum CEP válido consultado.
          </Text>
        ) : (
          consultas.map((item, index) => (
            <View style={styles.item} key={index}>
              <Text style={styles.itemText}>{item}</Text>
            </View>
          ))
        )}
      </ScrollView>
    </View>
  );
};

const App = () => {
  return (
    <NavigationContainer>
      <Drawer.Navigator
        initialRouteName="Home"
        screenOptions={({ route }) => ({
          drawerIcon: ({ color, size }) => {
            let iconName: string;

            switch (route.name) {
              case "Home":
                iconName = "home-outline";
                break;
              case "Morning":
                iconName = "sunny-outline";
                break;
              case "Afternoon":
                iconName = "partly-sunny-outline";
                break;
              case "Night":
                iconName = "moon-outline";
                break;
              case "CEP":
                iconName = "search-outline";
                break;
              case "Consultas":
                iconName = "list-outline";
                break;
              default:
                iconName = "alert-circle-outline";
            }

            return (
              <Ionicons name={iconName} size={size} color={color} />
            );
          },
        })}
      >
        <Drawer.Screen
          name="Home"
          component={Home}
          options={{ title: "Início" }}
        />

        <Drawer.Screen
          name="Morning"
          component={Manha}
          options={{ title: "Saudação de manhã" }}
        />

        <Drawer.Screen
          name="Afternoon"
          component={Tarde}
          options={{ title: "Saudação da tarde" }}
        />

        <Drawer.Screen
          name="Night"
          component={Noite}
          options={{ title: "Saudação para dormir" }}
        />

        <Drawer.Screen
          name="CEP"
          component={CEP}
          options={{ title: "Consultar CEP" }}
        />

        <Drawer.Screen
          name="Consultas"
          component={Consultas}
          options={{ title: "Consultas realizadas" }}
        />
      </Drawer.Navigator>
    </NavigationContainer>
  );
};

const styles = StyleSheet.create({
  container: {
    flex: 1,
    padding: 20,
    justifyContent: "center",
    alignItems: "center",
  },

  title: {
    fontSize: 28,
    fontWeight: "bold",
    marginBottom: 30,
  },

  rowButton: {
    flexDirection: "row",
    flexWrap: "wrap",
    justifyContent: "center",
    gap: 10,
  },

  button: {
    backgroundColor: "#333",
    padding: 15,
    margin: 8,
    borderRadius: 8,
    minWidth: 120,
    alignItems: "center",
  },

  buttonText: {
    color: "#fff",
    fontSize: 16,
  },

  input: {
    width: 270,
    height: 50,
    borderWidth: 1,
    borderColor: "#777",
    borderRadius: 8,
    paddingHorizontal: 15,
    marginBottom: 10,
    fontSize: 18,
  },

  resultado: {
    width: 300,
    padding: 15,
    borderWidth: 1,
    borderRadius: 8,
    marginTop: 20,
    gap: 5,
  },

  error: {
    color: "red",
    fontSize: 18,
    marginTop: 15,
  },

  lista: {
    width: "100%",
  },

  item: {
    padding: 15,
    borderWidth: 1,
    borderRadius: 8,
    marginBottom: 10,
  },

  itemText: {
    fontSize: 18,
  },

  semConsultas: {
    textAlign: "center",
    fontSize: 16,
  },
});

export default App;
